# Copy to .env for local development (never commit .env)

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
FRONTEND_ORIGIN=http://localhost:3000

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://samu:samu@localhost:5432/samu?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# MinIO / S3 (photos — Phase B10+)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=samu
S3_SECRET_KEY=samu-secret
S3_BUCKET=samu-uploads

# GPS validation threshold (meters from agent registered location)
GPS_DISTANCE_METERS=10

# Transactional email (forgot password + new-user invites) via https://resend.com
# Leave RESEND_API_KEY empty in development: the email (with its link) is logged
# to the API console instead of being sent.
# RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="SAMU <no-reply@solektra.rw>"
PASSWORD_RESET_TTL=1h
PASSWORD_INVITE_TTL=3d

# JWT secrets — generate strong values before staging/prod
# Example: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-dev-only-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-dev-only-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
