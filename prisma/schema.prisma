// SAMU Prisma schema — Phase B14 adds settings, audit logs, messaging stub.
// Keep this file the single source of DB truth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Lightweight marker row so migrate/deploy always has at least one model
/// and operators can verify write connectivity during health checks.
model SchemaMeta {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("schema_meta")
}

enum UserRole {
  ADMIN
  OPERATIONS_MANAGER
  MD_VIEWER
  TERRITORY_COORDINATOR
  COMMUNITY_OPPORTUNITY_ASSOCIATE
  AGENT
}

enum UserStatus {
  active
  pending
  disabled
}

enum TerritoryType {
  province
  district
  sector
  cell
}

/// Network lifecycle: Agent candidate → Irembo agent (certified).
enum AgentStatus {
  Candidate
  InTraining
  ExamPending
  Certified
  Inactive
}

enum OfficeType {
  kiosk
  room
  desk
}

enum ReviewStatus {
  pending_review
  accepted
  rejected
}

enum SupportChannel {
  phone
  whatsapp
  in_person
  other
}

enum ComplianceTone {
  green
  yellow
  red
}

enum ServiceLine {
  irembo
  bk
  internet
  device_financing
  insurance
  clean_cooking
}

enum LeadStatus {
  new
  contacted
  qualified
  converted
  lost
}

enum LeadEntityType {
  person
  household
  business
}

enum FieldActivityType {
  education
  demo
  mobilization
  support
  campaign
}

enum OnboardingKind {
  customer
  irembo_agent
  insurance_agent
  bk_account
  internet_activation
  device_registration
  cooker_purchase
}

enum OnboardingStatus {
  not_started
  in_progress
  pending_partner
  completed
  cancelled
}

enum SaleProductCategory {
  internet_4g
  internet_starlink
  smartphone
  induction_cooker
  insurance_policy
  other
}

enum FeedbackKind {
  need
  challenge
  opportunity
}

enum FeedbackSeverity {
  low
  medium
  high
}

enum FeedbackStatus {
  open
  acknowledged
  resolved
}

enum VisitValidation {
  accepted
  flagged
  rejected
}

enum SmsConfirmationStatus {
  pending
  confirmed
  disputed
  expired
  delivery_failed
}

enum FraudSeverity {
  low
  medium
  high
}

enum FraudStatus {
  open
  escalated
  resolved
  dismissed
}

enum ReportStatus {
  draft
  submitted
  under_review
  changes_requested
  resubmitted
  reviewed
  evaluated
}

enum ScorecardStatus {
  draft
  submitted
}

enum ScorecardDecision {
  Outstanding
  MeetsExpectations  @map("Meets expectations")
  NeedsImprovement   @map("Needs improvement")
  Unsatisfactory
}

enum MessageStatus {
  stub_queued
  stub_sent
  stub_failed
}

/// How a COA imihigo metric collects proof.
enum CoaEvidenceType {
  client_rows
  file_upload
  auto_irembo
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  phone            String?
  name             String
  passwordHash     String     @map("password_hash")
  role             UserRole
  status           UserStatus @default(pending)
  avatarInitials   String?    @map("avatar_initials")
  /// R2 object key or public URL for profile photo (Phase 7).
  avatarUrl        String?    @map("avatar_url")
  /// Optional national ID (masked display / optional on COA import).
  nidMasked        String?    @map("nid_masked")
  workingProvince  String?    @map("working_province")
  workingDistrict  String?    @map("working_district")
  /// Optional link for AGENT-role portal users (set when agent account is provisioned).
  agentId          String?    @unique @map("agent_id")
  lastLoginAt      DateTime?  @map("last_login_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  agent                 Agent?                @relation("UserPortalAgent", fields: [agentId], references: [id], onDelete: SetNull)
  refreshTokens         RefreshToken[]
  passwordResetTokens   PasswordResetToken[]
  territoryAssignments  TerritoryAssignment[]
  activeTerritories     Territory[]           @relation("TerritoryActiveTc")
  coordinatedAgents     Agent[]               @relation("AgentTc")
  recruitedAgents       Agent[]               @relation("AgentRecruitedBy")
  agentAssignments      AgentAssignment[]     @relation("AgentAssignmentTc")
  inviteLinks           InviteLink[]          @relation("InviteLinkOwner")
  supportLogs           SupportLog[]          @relation("SupportLogTc")
  trainingUploads       TrainingSession[]     @relation("TrainingUploader")
  leads                 Lead[]                @relation("LeadTc")
  fieldActivities       FieldActivity[]       @relation("FieldActivityTc")
  onboardingCases       OnboardingCase[]      @relation("OnboardingTc")
  sales                 Sale[]                @relation("SaleTc")
  communityFeedback     CommunityFeedback[]   @relation("FeedbackTc")
  visits                Visit[]               @relation("VisitTc")
  fraudFlagsReviewed    FraudFlag[]           @relation("FraudReviewer")
  fraudFlagsAssigned    FraudFlag[]           @relation("FraudAssignee")
  monthlyReports        MonthlyReport[]       @relation("ReportTc")
  scorecards            Scorecard[]           @relation("ScorecardTc")
  scorecardsEvaluated   Scorecard[]           @relation("ScorecardEvaluator")
  auditLogs             AuditLog[]            @relation("AuditActor")
  settingsUpdates       SystemSettings[]      @relation("SettingsUpdater")
  messagesSent          MessageOutbox[]       @relation("MessageSender")
  coaMetricOverrides    CoaMetricOverride[]   @relation("CoaMetricOverrideCoa")
  coaPerformanceEntries CoaPerformanceEntry[] @relation("CoaPerformanceCoa")

  @@index([role])
  @@index([status])
  @@index([workingDistrict])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

/// One-time password reset / account invite link. Only the SHA-256 hash is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  /// Set when the token is consumed or superseded by a newer one.
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Rwanda geo hierarchy (province → district → sector → cell).
/// Stable string ids (e.g. dist-gasabo) keep seeds aligned with the demo frontend.
model Territory {
  id             String        @id
  name           String
  type           TerritoryType
  parentId       String?       @map("parent_id")
  /// Denormalized active TC for districts; kept in sync on assign/unassign.
  activeTcUserId String?       @map("active_tc_user_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  parent      Territory?            @relation("TerritoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Territory[]           @relation("TerritoryTree")
  activeTc    User?                 @relation("TerritoryActiveTc", fields: [activeTcUserId], references: [id], onDelete: SetNull)
  assignments TerritoryAssignment[]

  @@index([parentId])
  @@index([type])
  @@index([activeTcUserId])
  @@map("territories")
}

model TerritoryAssignment {
  id          String    @id @default(cuid())
  territoryId String    @map("territory_id")
  tcUserId    String    @map("tc_user_id")
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  territory Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  tcUser    User      @relation(fields: [tcUserId], references: [id], onDelete: Cascade)

  @@index([territoryId])
  @@index([tcUserId])
  @@index([active])
  @@map("territory_assignments")
}

model Agent {
  id                     String         @id
  code                   String         @unique
  name                   String
  phone                  String
  email                  String?
  nidMasked              String         @map("nid_masked")
  nidVerified            Boolean        @default(false) @map("nid_verified")
  status                 AgentStatus    @default(Candidate)
  reviewStatus           ReviewStatus   @default(accepted) @map("review_status")
  age                    Int?
  gender                 String?
  education              String?
  tin                    String?
  businessType           String?        @map("business_type")
  venue                  String?
  emergencyContactName   String?        @map("emergency_contact_name")
  emergencyContactPhone  String?        @map("emergency_contact_phone")
  criminalRecordBillId   String?        @map("criminal_record_bill_id")
  certificateStorageKey  String?        @map("certificate_storage_key")
  hasPrinterScanner      Boolean        @default(false) @map("has_printer_scanner")
  hasComputer            Boolean        @default(false) @map("has_computer")
  officeType             OfficeType?    @map("office_type")
  building               String?
  geoProvince            String         @map("geo_province")
  geoDistrict            String         @map("geo_district")
  geoSector              String         @map("geo_sector")
  geoCell                String         @map("geo_cell")
  geoVillage             String?        @map("geo_village")
  lat                    Float
  lng                    Float
  accuracyMeters         Float?         @map("accuracy_meters")
  /// Null until Admin assigns a TC (e.g. COA-recruited candidates).
  tcUserId               String?        @map("tc_user_id")
  recruitedByUserId      String?        @map("recruited_by_user_id")
  examScore              Float?         @map("exam_score")
  iremboAccountCreatedAt DateTime?      @map("irembo_account_created_at")
  /// Service readiness checklist (irembo, bk, internet, cooking, …).
  servicesJson           Json           @map("services_json")
  lastVisitAt            DateTime?      @map("last_visit_at")
  compliance             ComplianceTone @default(yellow)
  clientsRegistered      Int            @default(0) @map("clients_registered")
  recruitedThisMonth     Boolean        @default(false) @map("recruited_this_month")
  reactivatedThisMonth   Boolean        @default(false) @map("reactivated_this_month")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  tcUser           User?              @relation("AgentTc", fields: [tcUserId], references: [id], onDelete: Restrict)
  recruitedBy      User?              @relation("AgentRecruitedBy", fields: [recruitedByUserId], references: [id], onDelete: SetNull)
  assignments      AgentAssignment[]
  portalUsers      User[]             @relation("UserPortalAgent")
  fieldActivities  FieldActivity[]
  onboardingCases  OnboardingCase[]
  visits           Visit[]
  supportLogs      SupportLog[]
  trainingAttendance TrainingAttendance[]

  @@index([tcUserId])
  @@index([recruitedByUserId])
  @@index([status])
  @@index([reviewStatus])
  @@index([compliance])
  @@index([geoProvince])
  @@index([geoDistrict])
  @@index([name])
  @@map("agents")
}

/// Shareable registration link for a TC or COA.
model InviteLink {
  id          String   @id @default(cuid())
  token       String   @unique
  ownerUserId String   @map("owner_user_id")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner User @relation("InviteLinkOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId])
  @@index([token])
  @@map("invite_links")
}

model TrainingSession {
  id          String   @id @default(cuid())
  title       String?
  sessionDate DateTime @map("session_date") @db.Date
  uploadedByUserId String @map("uploaded_by_user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  uploadedBy  User @relation("TrainingUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  attendance  TrainingAttendance[]

  @@index([sessionDate])
  @@map("training_sessions")
}

model TrainingAttendance {
  id               String  @id @default(cuid())
  sessionId        String  @map("session_id")
  agentId          String? @map("agent_id")
  email            String
  attended         Boolean @default(true)
  followUpNote     String? @map("follow_up_note")

  session TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  agent   Agent?          @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([agentId])
  @@index([email])
  @@map("training_attendance")
}

model SupportLog {
  id          String         @id @default(cuid())
  tcUserId    String         @map("tc_user_id")
  agentId     String         @map("agent_id")
  supportedAt DateTime       @map("supported_at")
  channel     SupportChannel @default(phone)
  summary     String
  outcome     String?
  createdAt   DateTime       @default(now()) @map("created_at")

  tcUser User  @relation("SupportLogTc", fields: [tcUserId], references: [id], onDelete: Restrict)
  agent  Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([tcUserId])
  @@index([agentId])
  @@index([supportedAt])
  @@map("support_logs")
}

model AgentAssignment {
  id        String    @id @default(cuid())
  agentId   String    @map("agent_id")
  tcUserId  String    @map("tc_user_id")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")

  agent  Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tcUser User  @relation("AgentAssignmentTc", fields: [tcUserId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([tcUserId])
  @@index([active])
  @@map("agent_assignments")
}

/// COAP lead — opportunity captured by a TC (or Admin/Ops on their behalf).
model Lead {
  id               String         @id
  name             String
  phone            String
  entityType       LeadEntityType @map("entity_type")
  serviceLine      ServiceLine    @map("service_line")
  status           LeadStatus     @default(new)
  geoProvince      String         @map("geo_province")
  geoDistrict      String         @map("geo_district")
  geoSector        String         @map("geo_sector")
  tcUserId         String         @map("tc_user_id")
  interestSummary  String?        @map("interest_summary")
  notes            String?
  convertedAt      DateTime?      @map("converted_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  tcUser          User             @relation("LeadTc", fields: [tcUserId], references: [id], onDelete: Restrict)
  fieldActivities   FieldActivity[]
  onboardingCases   OnboardingCase[]
  sales             Sale[]
  communityFeedback CommunityFeedback[]

  @@index([tcUserId])
  @@index([serviceLine])
  @@index([status])
  @@index([geoDistrict])
  @@index([updatedAt])
  @@map("leads")
}

/// COAP field activity — education, demo, mobilization, support, or campaign.
model FieldActivity {
  id             String            @id
  tcUserId       String            @map("tc_user_id")
  serviceLine    ServiceLine       @map("service_line")
  activityType   FieldActivityType @map("activity_type")
  /// Calendar date of the activity (YYYY-MM-DD semantics).
  date           DateTime          @db.Date
  geoProvince    String            @map("geo_province")
  geoDistrict    String            @map("geo_district")
  geoSector      String            @map("geo_sector")
  venue          String
  peopleReached  Int               @map("people_reached")
  summary        String
  outcome        String
  leadId         String?           @map("lead_id")
  agentId        String?           @map("agent_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  tcUser User   @relation("FieldActivityTc", fields: [tcUserId], references: [id], onDelete: Restrict)
  lead   Lead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  agent  Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([tcUserId])
  @@index([serviceLine])
  @@index([activityType])
  @@index([date])
  @@index([geoDistrict])
  @@index([leadId])
  @@index([agentId])
  @@map("field_activities")
}

/// COAP onboarding case — customer/agent activation workflow.
model OnboardingCase {
  id             String           @id
  tcUserId       String           @map("tc_user_id")
  serviceLine    ServiceLine      @map("service_line")
  kind           OnboardingKind
  status         OnboardingStatus @default(not_started)
  customerName   String           @map("customer_name")
  customerPhone  String           @map("customer_phone")
  leadId         String?          @map("lead_id")
  agentId        String?          @map("agent_id")
  geoProvince    String           @map("geo_province")
  geoDistrict    String           @map("geo_district")
  geoSector      String           @map("geo_sector")
  stageLabel     String           @map("stage_label")
  notes          String?
  startedAt      DateTime         @default(now()) @map("started_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  completedAt    DateTime?        @map("completed_at")

  tcUser User   @relation("OnboardingTc", fields: [tcUserId], references: [id], onDelete: Restrict)
  lead   Lead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  agent  Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  sales  Sale[]

  @@index([tcUserId])
  @@index([serviceLine])
  @@index([status])
  @@index([kind])
  @@index([geoDistrict])
  @@index([leadId])
  @@index([agentId])
  @@index([updatedAt])
  @@map("onboarding_cases")
}

/// COAP sale — product sold through a TC territory pipeline.
model Sale {
  id                 String              @id
  tcUserId           String              @map("tc_user_id")
  serviceLine        ServiceLine         @map("service_line")
  productCategory    SaleProductCategory @map("product_category")
  productName        String              @map("product_name")
  quantity           Int                 @default(1)
  amountRwf          Int                 @map("amount_rwf")
  customerName       String              @map("customer_name")
  customerPhone      String              @map("customer_phone")
  leadId             String?             @map("lead_id")
  onboardingId       String?             @map("onboarding_id")
  depositRwf         Int?                @map("deposit_rwf")
  installmentMonths  Int?                @map("installment_months")
  geoProvince        String              @map("geo_province")
  geoDistrict        String              @map("geo_district")
  geoSector          String              @map("geo_sector")
  soldAt             DateTime            @map("sold_at")
  notes              String?
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")

  tcUser     User            @relation("SaleTc", fields: [tcUserId], references: [id], onDelete: Restrict)
  lead       Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  onboarding OnboardingCase? @relation(fields: [onboardingId], references: [id], onDelete: SetNull)

  @@index([tcUserId])
  @@index([serviceLine])
  @@index([productCategory])
  @@index([geoDistrict])
  @@index([soldAt])
  @@index([leadId])
  @@index([onboardingId])
  @@map("sales")
}

/// COAP community feedback — needs, challenges, and opportunities from the field.
model CommunityFeedback {
  id               String            @id
  tcUserId         String            @map("tc_user_id")
  serviceLine      ServiceLine?      @map("service_line")
  kind             FeedbackKind
  severity         FeedbackSeverity
  status           FeedbackStatus    @default(open)
  title            String
  description      String
  geoProvince      String            @map("geo_province")
  geoDistrict      String            @map("geo_district")
  geoSector        String            @map("geo_sector")
  leadId           String?           @map("lead_id")
  resolutionNotes  String?           @map("resolution_notes")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  tcUser User  @relation("FeedbackTc", fields: [tcUserId], references: [id], onDelete: Restrict)
  lead   Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([tcUserId])
  @@index([serviceLine])
  @@index([kind])
  @@index([severity])
  @@index([status])
  @@index([geoDistrict])
  @@index([leadId])
  @@index([updatedAt])
  @@map("community_feedback")
}

/// Field visit captured by a TC (or Admin) at an agent's registered location.
model Visit {
  id                            String                @id
  agentId                       String                @map("agent_id")
  tcUserId                      String                @map("tc_user_id")
  purpose                       String
  startedAt                     DateTime              @map("started_at")
  endedAt                       DateTime              @map("ended_at")
  durationMinutes               Int                   @map("duration_minutes")
  activities                    String
  outcome                       String
  lat                           Float
  lng                           Float
  accuracyMeters                Float?                @map("accuracy_meters")
  distanceFromRegisteredMeters  Int                   @map("distance_from_registered_meters")
  validation                    VisitValidation
  confirmationStatus            SmsConfirmationStatus @default(pending) @map("confirmation_status")
  challenges                    String?
  supportNeeded                 String?               @map("support_needed")
  flaggedReason                 String?               @map("flagged_reason")
  /// Snapshot of agent readiness checklist at visit time.
  checklistJson                 Json?                 @map("checklist_json")
  /// COAP service lines touched during the visit.
  serviceLinesJson              Json?                 @map("service_lines_json")
  deviceInfo                    String?               @map("device_info")
  /// Optional client Idempotency-Key (retry-safe create).
  idempotencyKey                String?               @unique @map("idempotency_key")
  createdAt                     DateTime              @default(now()) @map("created_at")
  updatedAt                     DateTime              @updatedAt @map("updated_at")

  agent      Agent        @relation(fields: [agentId], references: [id], onDelete: Restrict)
  tcUser     User         @relation("VisitTc", fields: [tcUserId], references: [id], onDelete: Restrict)
  photos     VisitPhoto[]
  fraudFlags FraudFlag[]

  @@index([agentId])
  @@index([tcUserId])
  @@index([validation])
  @@index([confirmationStatus])
  @@index([purpose])
  @@index([startedAt])
  @@map("visits")
}

model VisitPhoto {
  id          String   @id @default(cuid())
  visitId     String   @map("visit_id")
  storageKey  String   @map("storage_key")
  fileName    String   @map("file_name")
  contentType String   @map("content_type")
  sizeBytes   Int      @map("size_bytes")
  createdAt   DateTime @default(now()) @map("created_at")

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
  @@index([storageKey])
  @@map("visit_photos")
}

/// Suspicious visit markers — reviewed by Admin / Ops (Phase B11).
model FraudFlag {
  id                   String        @id
  visitId              String        @map("visit_id")
  type                 String
  severity             FraudSeverity
  status               FraudStatus   @default(open)
  notes                String?
  resolution           String?
  detectedAt           DateTime      @map("detected_at")
  reviewedAt           DateTime?     @map("reviewed_at")
  reviewedByUserId     String?       @map("reviewed_by_user_id")
  assignedReviewerId   String?       @map("assigned_reviewer_id")
  /// Append-only review events (accept, escalate, dismiss, note).
  reviewHistoryJson    Json          @default("[]") @map("review_history_json")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  visit              Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  reviewedBy         User? @relation("FraudReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  assignedReviewer   User? @relation("FraudAssignee", fields: [assignedReviewerId], references: [id], onDelete: SetNull)

  @@index([visitId])
  @@index([status])
  @@index([severity])
  @@index([type])
  @@index([detectedAt])
  @@index([assignedReviewerId])
  @@map("fraud_flags")
}

/// TC monthly narrative + KPI snapshot for Head Office review.
model MonthlyReport {
  id                     String       @id
  tcUserId               String       @map("tc_user_id")
  period                 String
  status                 ReportStatus @default(draft)
  deadline               DateTime     @db.Date
  submittedAt            DateTime?    @map("submitted_at")
  territorySnapshotJson  Json         @default("[]") @map("territory_snapshot_json")
  kpiActualsJson         Json         @default("{}") @map("kpi_actuals_json")
  narrativeJson          Json         @default("{}") @map("narrative_json")
  agentSnapshotJson      Json         @default("[]") @map("agent_snapshot_json")
  historyJson            Json         @default("[]") @map("history_json")
  reviewNotes            String?      @map("review_notes")
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  tcUser    User       @relation("ReportTc", fields: [tcUserId], references: [id], onDelete: Restrict)
  scorecard Scorecard?

  @@unique([tcUserId, period])
  @@index([status])
  @@index([period])
  @@index([deadline])
  @@map("monthly_reports")
}

/// Head Office evaluation of a submitted monthly report.
model Scorecard {
  id                String             @id
  monthlyReportId   String             @unique @map("monthly_report_id")
  tcUserId          String             @map("tc_user_id")
  period            String
  status            ScorecardStatus    @default(draft)
  templateVersion   String             @default("v1-2026") @map("template_version")
  criteriaJson      Json               @map("criteria_json")
  overallComment    String             @default("") @map("overall_comment")
  decision          ScorecardDecision?
  weightedTotal     Float              @default(0) @map("weighted_total")
  evaluatorUserId   String?            @map("evaluator_user_id")
  submittedAt       DateTime?          @map("submitted_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  monthlyReport MonthlyReport @relation(fields: [monthlyReportId], references: [id], onDelete: Cascade)
  tcUser        User          @relation("ScorecardTc", fields: [tcUserId], references: [id], onDelete: Restrict)
  evaluator     User?         @relation("ScorecardEvaluator", fields: [evaluatorUserId], references: [id], onDelete: SetNull)

  @@index([tcUserId])
  @@index([period])
  @@index([status])
  @@map("scorecards")
}

/// Singleton system configuration (id = "default").
model SystemSettings {
  id                   String   @id @default("default")
  gpsDistanceMeters    Int      @default(10) @map("gps_distance_meters")
  agentGreenDays       Int      @default(60) @map("agent_green_days")
  agentYellowDays      Int      @default(30) @map("agent_yellow_days")
  tcComplianceGreen    Int      @default(90) @map("tc_compliance_green")
  tcComplianceYellow   Int      @default(70) @map("tc_compliance_yellow")
  monthlyReportDueDay  Int      @default(5) @map("monthly_report_due_day")
  kpiTargetsJson       Json     @map("kpi_targets_json")
  /// Optional SMS template bodies keyed by template id.
  smsTemplatesJson     Json     @default("{}") @map("sms_templates_json")
  updatedAt            DateTime @updatedAt @map("updated_at")
  updatedByUserId      String?  @map("updated_by_user_id")

  updatedBy User? @relation("SettingsUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?  @map("actor_user_id")
  action       String
  objectType   String   @map("object_type")
  objectId     String   @map("object_id")
  summary      String
  ip           String?
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([action])
  @@index([objectType])
  @@index([objectId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Outbound SMS queue — stub provider only (no real gateway in B14).
model MessageOutbox {
  id           String        @id @default(cuid())
  toPhone      String        @map("to_phone")
  body         String
  templateId   String?       @map("template_id")
  status       MessageStatus @default(stub_queued)
  visitId      String?       @map("visit_id")
  agentId      String?       @map("agent_id")
  createdById  String?       @map("created_by_id")
  providerRef  String?       @map("provider_ref")
  errorMessage String?       @map("error_message")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  createdBy User? @relation("MessageSender", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([toPhone])
  @@index([createdAt])
  @@index([visitId])
  @@index([agentId])
  @@map("message_outbox")
}

/// Global COA imihigo metric catalog (shared targets; per-COA overrides later).
model CoaMetric {
  id            String          @id @default(cuid())
  key           String          @unique
  label         String
  description   String?
  /// Admin note shown in UI (e.g. solar priority guidance).
  adminNote     String?         @map("admin_note")
  monthlyTarget Int             @map("monthly_target")
  evidenceType  CoaEvidenceType @map("evidence_type")
  enabled       Boolean         @default(true)
  sortOrder     Int             @default(0) @map("sort_order")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  overrides CoaMetricOverride[]
  entries   CoaPerformanceEntry[]

  @@index([enabled])
  @@index([sortOrder])
  @@map("coa_metrics")
}

/// Reserved for later per-COA target/enabled overrides (no UI in Phase 1–5).
model CoaMetricOverride {
  id            String   @id @default(cuid())
  metricId      String   @map("metric_id")
  coaUserId     String   @map("coa_user_id")
  monthlyTarget Int?     @map("monthly_target")
  enabled       Boolean?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  metric CoaMetric @relation(fields: [metricId], references: [id], onDelete: Cascade)
  coa    User      @relation("CoaMetricOverrideCoa", fields: [coaUserId], references: [id], onDelete: Cascade)

  @@unique([metricId, coaUserId])
  @@index([coaUserId])
  @@map("coa_metric_overrides")
}

/// One COA logging session against a metric for a calendar month (YYYY-MM).
model CoaPerformanceEntry {
  id        String   @id @default(cuid())
  metricId  String   @map("metric_id")
  coaUserId String   @map("coa_user_id")
  /// Calendar month key, e.g. 2026-11.
  month     String
  notes     String?
  loggedAt  DateTime @default(now()) @map("logged_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  metric      CoaMetric           @relation(fields: [metricId], references: [id], onDelete: Restrict)
  coa         User                @relation("CoaPerformanceCoa", fields: [coaUserId], references: [id], onDelete: Cascade)
  clientRows  CoaEvidenceClient[]
  files       CoaEvidenceFile[]

  @@index([coaUserId, month])
  @@index([metricId, month])
  @@index([loggedAt])
  @@map("coa_performance_entries")
}

/// Structured client-row evidence for metrics that require contact details.
model CoaEvidenceClient {
  id              String   @id @default(cuid())
  entryId         String   @map("entry_id")
  fullName        String   @map("full_name")
  phone           String?
  email           String?
  nidNumber       String?  @map("nid_number")
  /// BK account number or similar reference.
  accountRef      String?  @map("account_ref")
  /// 4G SIM number for internet subscriptions.
  simNumber       String?  @map("sim_number")
  createdAt       DateTime @default(now()) @map("created_at")

  entry CoaPerformanceEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([phone])
  @@map("coa_evidence_clients")
}

/// File evidence stored in R2/S3 (instalment agreements, certificates, etc.).
model CoaEvidenceFile {
  id           String   @id @default(cuid())
  entryId      String   @map("entry_id")
  storageKey   String   @map("storage_key")
  originalName String   @map("original_name")
  contentType  String   @map("content_type")
  sizeBytes    Int      @map("size_bytes")
  createdAt    DateTime @default(now()) @map("created_at")

  entry CoaPerformanceEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@index([storageKey])
  @@map("coa_evidence_files")
}
