// SAMU Prisma schema — Phase B5 adds COAP field activities.
// Keep this file the single source of DB truth.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Lightweight marker row so migrate/deploy always has at least one model
/// and operators can verify write connectivity during health checks.
model SchemaMeta {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("schema_meta")
}

enum UserRole {
  ADMIN
  OPERATIONS_MANAGER
  MD_VIEWER
  TERRITORY_COORDINATOR
  AGENT
}

enum UserStatus {
  active
  pending
  disabled
}

enum TerritoryType {
  province
  district
  sector
  cell
}

enum AgentStatus {
  Active
  Inactive
  Suspended
  PendingVerification @map("Pending verification")
}

enum ComplianceTone {
  green
  yellow
  red
}

enum ServiceLine {
  irembo
  bk
  internet
  device_financing
  insurance
  clean_cooking
}

enum LeadStatus {
  new
  contacted
  qualified
  converted
  lost
}

enum LeadEntityType {
  person
  household
  business
}

enum FieldActivityType {
  education
  demo
  mobilization
  support
  campaign
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  phone          String?
  name           String
  passwordHash   String     @map("password_hash")
  role           UserRole
  status         UserStatus @default(pending)
  avatarInitials String?    @map("avatar_initials")
  /// Optional link for AGENT-role portal users (set when agent account is provisioned).
  agentId        String?    @unique @map("agent_id")
  lastLoginAt    DateTime?  @map("last_login_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  agent                 Agent?                @relation("UserPortalAgent", fields: [agentId], references: [id], onDelete: SetNull)
  refreshTokens         RefreshToken[]
  territoryAssignments  TerritoryAssignment[]
  activeTerritories     Territory[]           @relation("TerritoryActiveTc")
  coordinatedAgents     Agent[]               @relation("AgentTc")
  agentAssignments      AgentAssignment[]     @relation("AgentAssignmentTc")
  leads                 Lead[]                @relation("LeadTc")
  fieldActivities       FieldActivity[]       @relation("FieldActivityTc")

  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

/// Rwanda geo hierarchy (province → district → sector → cell).
/// Stable string ids (e.g. dist-gasabo) keep seeds aligned with the demo frontend.
model Territory {
  id             String        @id
  name           String
  type           TerritoryType
  parentId       String?       @map("parent_id")
  /// Denormalized active TC for districts; kept in sync on assign/unassign.
  activeTcUserId String?       @map("active_tc_user_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  parent      Territory?            @relation("TerritoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Territory[]           @relation("TerritoryTree")
  activeTc    User?                 @relation("TerritoryActiveTc", fields: [activeTcUserId], references: [id], onDelete: SetNull)
  assignments TerritoryAssignment[]

  @@index([parentId])
  @@index([type])
  @@index([activeTcUserId])
  @@map("territories")
}

model TerritoryAssignment {
  id          String    @id @default(cuid())
  territoryId String    @map("territory_id")
  tcUserId    String    @map("tc_user_id")
  startedAt   DateTime  @default(now()) @map("started_at")
  endedAt     DateTime? @map("ended_at")
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now()) @map("created_at")

  territory Territory @relation(fields: [territoryId], references: [id], onDelete: Cascade)
  tcUser    User      @relation(fields: [tcUserId], references: [id], onDelete: Cascade)

  @@index([territoryId])
  @@index([tcUserId])
  @@index([active])
  @@map("territory_assignments")
}

model Agent {
  id                     String         @id
  code                   String         @unique
  name                   String
  phone                  String
  email                  String?
  nidMasked              String         @map("nid_masked")
  nidVerified            Boolean        @default(false) @map("nid_verified")
  status                 AgentStatus    @default(Active)
  geoProvince            String         @map("geo_province")
  geoDistrict            String         @map("geo_district")
  geoSector              String         @map("geo_sector")
  geoCell                String         @map("geo_cell")
  lat                    Float
  lng                    Float
  accuracyMeters         Float?         @map("accuracy_meters")
  tcUserId               String         @map("tc_user_id")
  /// Service readiness checklist (irembo, bk, internet, cooking, …).
  servicesJson           Json           @map("services_json")
  lastVisitAt            DateTime?      @map("last_visit_at")
  compliance             ComplianceTone @default(yellow)
  clientsRegistered      Int            @default(0) @map("clients_registered")
  recruitedThisMonth     Boolean        @default(false) @map("recruited_this_month")
  reactivatedThisMonth   Boolean        @default(false) @map("reactivated_this_month")
  createdAt              DateTime       @default(now()) @map("created_at")
  updatedAt              DateTime       @updatedAt @map("updated_at")

  tcUser      User              @relation("AgentTc", fields: [tcUserId], references: [id], onDelete: Restrict)
  assignments     AgentAssignment[]
  portalUsers     User[]            @relation("UserPortalAgent")
  fieldActivities FieldActivity[]

  @@index([tcUserId])
  @@index([status])
  @@index([compliance])
  @@index([geoProvince])
  @@index([geoDistrict])
  @@index([name])
  @@map("agents")
}

model AgentAssignment {
  id        String    @id @default(cuid())
  agentId   String    @map("agent_id")
  tcUserId  String    @map("tc_user_id")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  active    Boolean   @default(true)
  createdAt DateTime  @default(now()) @map("created_at")

  agent  Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tcUser User  @relation("AgentAssignmentTc", fields: [tcUserId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([tcUserId])
  @@index([active])
  @@map("agent_assignments")
}

/// COAP lead — opportunity captured by a TC (or Admin/Ops on their behalf).
model Lead {
  id               String         @id
  name             String
  phone            String
  entityType       LeadEntityType @map("entity_type")
  serviceLine      ServiceLine    @map("service_line")
  status           LeadStatus     @default(new)
  geoProvince      String         @map("geo_province")
  geoDistrict      String         @map("geo_district")
  geoSector        String         @map("geo_sector")
  tcUserId         String         @map("tc_user_id")
  interestSummary  String?        @map("interest_summary")
  notes            String?
  convertedAt      DateTime?      @map("converted_at")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  tcUser          User            @relation("LeadTc", fields: [tcUserId], references: [id], onDelete: Restrict)
  fieldActivities FieldActivity[]

  @@index([tcUserId])
  @@index([serviceLine])
  @@index([status])
  @@index([geoDistrict])
  @@index([updatedAt])
  @@map("leads")
}

/// COAP field activity — education, demo, mobilization, support, or campaign.
model FieldActivity {
  id             String            @id
  tcUserId       String            @map("tc_user_id")
  serviceLine    ServiceLine       @map("service_line")
  activityType   FieldActivityType @map("activity_type")
  /// Calendar date of the activity (YYYY-MM-DD semantics).
  date           DateTime          @db.Date
  geoProvince    String            @map("geo_province")
  geoDistrict    String            @map("geo_district")
  geoSector      String            @map("geo_sector")
  venue          String
  peopleReached  Int               @map("people_reached")
  summary        String
  outcome        String
  leadId         String?           @map("lead_id")
  agentId        String?           @map("agent_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  tcUser User   @relation("FieldActivityTc", fields: [tcUserId], references: [id], onDelete: Restrict)
  lead   Lead?  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  agent  Agent? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([tcUserId])
  @@index([serviceLine])
  @@index([activityType])
  @@index([date])
  @@index([geoDistrict])
  @@index([leadId])
  @@index([agentId])
  @@map("field_activities")
}
